process {

    withName: 'FASTQC' {
        publishDir = [path: { "${params.outdir}/qc/fastqc" }, mode: 'copy', pattern: '*_fastqc.{html,zip}']
    }

    withName: 'FASTP' {
        ext.args   = '--detect_adapter_for_pe --cut_tail --cut_tail_mean_quality 20 --length_required 50'
        publishDir = [path: { "${params.outdir}/qc/fastp" }, mode: 'copy', pattern: '*.fastp.{json,html}']
    }

    withName: 'PREPARE_REFERENCE' {
        publishDir = [enabled: false]
    }

    withName: 'PREPARE_TARGETS' {
        publishDir = [path: { "${params.outdir}/reference" }, mode: 'copy', pattern: 'targets.bed']
    }

    withName: 'ALIGN_MARKDUP' {
        publishDir = [
            [path: { "${params.outdir}/alignment" },    mode: 'copy', pattern: '*.md.bam*'],
            [path: { "${params.outdir}/qc/alignment" }, mode: 'copy', pattern: '*.txt']
        ]
    }

    withName: 'COVERAGE_QC' {
        publishDir = [
            path: { "${params.outdir}/qc/coverage" },
            mode: 'copy',
            pattern: '*.{tsv,bed}',
            saveAs: { f -> f.endsWith('_summary.tsv') ? null : f }
        ]
    }

    withName: 'CALL_VARIANTS' {
        publishDir = [path: { "${params.outdir}/variants/raw" }, mode: 'copy', pattern: '*.{vcf.gz,vcf.gz.tbi,txt}']
    }

    withName: 'ANNOTATE_VARIANTS' {
        publishDir = [path: { "${params.outdir}/variants/annotated" }, mode: 'copy', pattern: '*.{vcf.gz,vcf.gz.tbi,tsv}']
    }

    withName: 'BENCHMARK' {
        publishDir = [
            path: { "${params.outdir}/benchmark" },
            mode: 'copy',
            pattern: '*.tsv',
            saveAs: { f -> f.endsWith('_summary.tsv') ? null : f }
        ]
    }

    withName: 'MULTIQC' {
        publishDir = [path: { "${params.outdir}/multiqc" }, mode: 'copy']
    }
}
