process {
    cpus   = 1
    memory = 2.GB
    time   = 2.h

    // requests above these limits are capped instead of failing;
    // override with a custom config (-c) to match the machine or cluster
    resourceLimits = [cpus: 4, memory: 8.GB, time: 24.h]

    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 143] ? 'retry' : 'finish' }
    maxRetries    = 1

    withLabel: 'process_single' {
        cpus   = 1
        memory = { 2.GB * task.attempt }
    }
    withLabel: 'process_low' {
        cpus   = 2
        memory = { 4.GB * task.attempt }
    }
    withLabel: 'process_medium' {
        cpus   = 4
        memory = { 8.GB * task.attempt }
    }
}
