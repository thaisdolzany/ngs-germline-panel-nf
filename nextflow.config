manifest {
    name            = 'ngs-germline-panel-nf'
    author          = 'Thaís Dolzany de Oliveira'
    homePage        = 'https://github.com/thaisdolzany/ngs-germline-panel-nf'
    description     = 'Germline SNV/indel calling and QC for targeted gene panels'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.10.0'
    version         = '1.0.0'
}

params {
    // inputs
    input             = null
    fasta             = null
    targets           = null
    dbsnp             = null
    dbsnp_tbi         = null

    // thresholds
    min_depth         = 20      // per-base depth used for coverage QC
    min_qual          = 30      // variant QUAL below this is soft-filtered
    min_variant_depth = 10      // FORMAT/DP below this is soft-filtered

    // output
    outdir            = 'results'
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

process.shell = ['/bin/bash', '-euo', 'pipefail']

profiles {
    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'
        singularity.enabled = false
        conda.enabled       = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        conda.enabled          = false
    }
    conda {
        conda.enabled       = true
        conda.channels      = ['conda-forge', 'bioconda']
        docker.enabled      = false
        singularity.enabled = false
    }
    test {
        includeConfig 'conf/test.config'
    }
}

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/report.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/trace.tsv"
}
